<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Translator_App_WinUI.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select translation region">
    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsTabStop="True" Loaded="OnLoaded" KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Drag over the text to translate" FontSize="20" FontWeight="SemiBold" />
        <Grid Grid.Row="1" x:Name="ImageSurface" Background="Black" SizeChanged="ImageSurfaceSizeChanged">
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <Canvas x:Name="SelectionCanvas" Background="Transparent"
                    Canvas.ZIndex="2"
                    IsHitTestVisible="True"
                    PointerPressed="SelectionPressed"
                    PointerMoved="SelectionMoved"
                    PointerReleased="SelectionReleased"
                    PointerCanceled="SelectionCanceled"
                    PointerCaptureLost="SelectionCaptureLost" />
            <Border x:Name="SelectionRectangle" Canvas.ZIndex="3" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#FF00A8FF" BorderThickness="3"
                    Background="#5538A8E8" Visibility="Collapsed" />
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="12">
            <TextBlock x:Name="SelectionStatus" VerticalAlignment="Center" Text="Select a region, then confirm." TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelSelection" />
                <Button Content="Confirm region" Click="ConfirmSelection" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
