<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Translator_App_WinUI.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1180" Padding="32,24,32,40" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Screen Translator" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Translate a bounded screen region without leaving your workflow." Opacity="0.72" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="16" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Local mode" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.9*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="20">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Translation setup" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox Header="Source language" ItemsSource="{x:Bind ViewModel.SourceLanguages}" SelectedItem="{x:Bind ViewModel.SourceLanguage, Mode=TwoWay}" />
                            <ComboBox Header="Target language" ItemsSource="{x:Bind ViewModel.TargetLanguages}" SelectedItem="{x:Bind ViewModel.TargetLanguage, Mode=TwoWay}" />
                            <TextBlock Text="Windows OCR uses the selected source language." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Typography" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox Header="Default font" ItemsSource="{x:Bind ViewModel.FontChoices}" SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                            <ToggleSwitch Header="Auto contrast" IsOn="{x:Bind ViewModel.AutoContrast, Mode=TwoWay}" />
                            <Slider Header="Translation size" Minimum="12" Maximum="30" StepFrequency="1" Value="{x:Bind ViewModel.TranslationFontSize, Mode=TwoWay}" />
                            <Button Content="Import font (.ttf / .otf)" Click="ImportFont" />
                            <TextBlock Text="{x:Bind ViewModel.FontStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Session" Style="{StaticResource SectionTitleStyle}" />
                            <Button x:Name="StartButton" Content="Start session" Click="StartSession" HorizontalAlignment="Stretch" />
                            <Button x:Name="StopButton" Content="Stop session" Click="StopSession" HorizontalAlignment="Stretch" IsEnabled="False" />
                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Provider" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Xiaomi MiMo is the default smoke-test provider. Enter a key each session." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                            <TextBox x:Name="EndpointBox" Header="OpenAI-compatible endpoint" Text="https://api.xiaomimimo.com/v1" />
                            <TextBox x:Name="ModelBox" Header="Model" Text="mimo-v2.5" />
                            <PasswordBox x:Name="ApiKeyBox" Header="API key (enter each session)" PlaceholderText="Required for Xiaomi MiMo" />
                            <TextBlock Text="The key is never saved. While active, OCR text is sent to this endpoint." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="20">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel Spacing="12">
                            <Grid><TextBlock Text="Region" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.RegionStatus, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" /></Grid>
                            <ComboBox Header="Visible Chrome window" ItemsSource="{x:Bind ViewModel.ChromeWindows}" SelectedItem="{x:Bind ViewModel.SelectedChromeWindow, Mode=TwoWay}" SelectionChanged="WindowSelectionChanged" DisplayMemberPath="Title" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Refresh windows" Click="RefreshChromeWindows" />
                                <Button x:Name="ChooseRegionButton" Content="Choose drag region" Click="ChooseRegion" IsEnabled="False" />
                            </StackPanel>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="5"><TextBlock Text="{x:Bind ViewModel.RegionTitle, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ViewModel.RegionDetail, Mode=OneWay}" Opacity="0.65" /><TextBlock Text="Drag across the frozen Chrome snapshot, then confirm." TextWrapping="Wrap" FontSize="12" Opacity="0.65" /></StackPanel>
                            </Border>
                            <TextBlock Text="The selected window is the initial bounded region; OCR starts after confirmation." TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource PanelStyle}"><StackPanel Spacing="10"><TextBlock Text="Source OCR" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" MinHeight="72" /><TextBlock Text="{x:Bind ViewModel.SourceState, Mode=OneWay}" FontSize="12" Opacity="0.5" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelStyle}"><StackPanel Spacing="10"><TextBlock Text="Translation" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{x:Bind ViewModel.TranslationText, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" MinHeight="72" /><TextBlock Text="{x:Bind ViewModel.TranslationState, Mode=OneWay}" FontSize="12" Opacity="0.5" /></StackPanel></Border>
                    </Grid>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Margin="0,24,0,0" Padding="14" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="6">
                <StackPanel Spacing="3"><TextBlock Text="Privacy" FontWeight="SemiBold" /><TextBlock Text="No screenshots are stored." /><TextBlock Text="Exactly the selected OCR text is sent to the configured endpoint." Opacity="0.65" TextWrapping="Wrap" /></StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
