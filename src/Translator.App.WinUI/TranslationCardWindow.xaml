<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Translator_App_WinUI.TranslationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation">
    <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <TextBlock x:Name="TranslationText" TextWrapping="Wrap" FontSize="16" />
    </Border>
</Window>
